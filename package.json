{
  "name": "frontend-publico",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "cross-env PORT=3001 nuxt dev --port 3001 --open",
    "dev:expose": "cross-env PORT=3001 nuxt dev --port 3001 --open --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "cross-env PORT=3000 nuxt preview --port 3000",
    "start": "cross-env PORT=3000 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "dev:win": "set PORT=3001 && nuxt dev --port 3001 --open",
    "preview:win": "set PORT=3001 && nuxt preview --port 3001",
    "start:win": "set PORT=3000 && node .output/server/index.mjs"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@pinia/nuxt": "^0.11.3",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "nuxt": "^4.2.2",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^3.47.0",
    "sharp": "^0.34.5",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "autoprefixer": "^10.4.23",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}